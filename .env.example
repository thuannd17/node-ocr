HOST=localhost
PORT=3000

OCR_TIMEOUT_MS=300000
# Files the /benchmark runs read at once (default 2: an image's OCR on the GPU overlaps another file's tagging; 3 was no faster)
# BENCHMARK_CONCURRENCY=2

# ── OCR Server (PaddleOCR) ─────────────────────────────────────
# OCR_SERVER_HOST=127.0.0.1
# OCR_SERVER_PORT=8501

# Stability mode: luôn chạy 1 worker để tránh treo máy
OCR_WORKERS=1

# Fast mode: dùng model nhỏ hơn, nhanh hơn (tự bật khi có GPU)
OCR_FAST_MODE=1
# OCR_FAST_DET_LIMIT_SIDE_LEN=640
# OCR_FAST_RECOGNITION_BATCH_SIZE=16

# Warmup engine khi khởi động (khuyên dùng)
OCR_WARMUP=1

# Recognition model (fine-tuned on labeled rosters). Versions live in
# models/rec/vN/ (infer/ = what the OCR server loads, model.json = how it was
# trained and how it scored). List / switch with:  npm run ocr:use-model [-- vN]
# Train + compare a new version on rosters the current one never saw:
#   npm run ocr:train
# History: v1 first fine-tune (09-22) -> v2 anchor recipe (deployed 09-25)
# -> v4 tight recipe (deployed 10-01; 5-fold CV row exact 50.8% vs stock 46.4%
# vs v2 41.3%). v3 (table-only) was never deployed.
# The recognition model in use is models/rec/active.json in MinIO (/models or npm run ocr:use-model
# switches it); the OCR server downloads it into the work folder at start.
# Mail server for the /helpdesk replies (services/mailer.js). Without SMTP_HOST + MAIL_FROM a reply opens the admin's mail program.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false                   # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="RosterParser <helpdesk@example.com>"
# MAIL_REPLY_TO=                      # optional: where the requester's answer goes
# OCR_REC_VERSION=v4                   # pin a version on this machine instead
# OCR_CUSTOM_REC=<folder>              # load a folder as it is (training runs do this)


# 2026-09-29: det limit 736 (fast-mode default) shrank ~700x1300 roster images
# to ~56%, so the detector merged adjacent table rows into one box (two rows
# in one row crop, garbled cells). 1920 = no downscale. Held-out val (9 images):
# row exact 13.6% -> 36.4%, same rec model. Remove this line to roll back.
OCR_TEXT_DET_LIMIT_SIDE_LEN=1920
# Table-only rec model (models/rec/v3/infer) was also
# benchmarked: published 58.4% -> 64.4% but planned 26.8% -> 23.6% on val —
# not switched yet.

# Roster data (media/, the media library): the roster files, labels and correction suggestions, in MinIO.
# minio (MINIO_* below) | fs (MEDIA_FS_DIR, a folder; no MinIO needed)
MEDIA_BACKEND=minio
# Work folder outside the project: mirror of MinIO (data + models), caches, training datasets, uploads
# (default: <system temp>/roster-ocr-work; utils/paths.js). Everything in it can be deleted.
# ROSTER_WORK_DIR=
# Local mirror of the data for OCR / training / benchmarks (default: <ROSTER_WORK_DIR>/media)
# MEDIA_CACHE_DIR=

# MinIO (the app talks to it directly; a key limited to MINIO_BUCKET, ACARS_BUCKET and SITE_BUCKET is enough)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=roster-ocr
# ACARS_BUCKET=acars-ocr               # the ACARS pictures and their labels (files/<name>, labels/<name>.json)
# SITE_BUCKET=site-data                # public data the site shows: airports.json (npm run airports:update)

# ── Admin sign-in (Firebase Authentication: services/auth.js, /login) ──
# Without FIREBASE_PROJECT_ID + FIREBASE_API_KEY login is off and the admin pages open only on this machine.
# The web app's config (Firebase console > Project settings > Your apps; public values):
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=                # default <project>.firebaseapp.com
# FIREBASE_PROJECT_ID=
# The admin SDK key file (Project settings > Service accounts > Generate new private key); keep it outside the project.
# Not needed on Cloud Run (its service account is used).
# GOOGLE_APPLICATION_CREDENTIALS=C:\keys\rosterparser-admin.json
# Admins: verified emails here, or any account given the claim with  npm run auth:grant -- <email>
# ADMIN_EMAILS=me@example.com,other@example.com
# AUTH_PROVIDERS=google,github,password

# ── OCR server on another machine (the app on Cloud Run, this machine's OCR server behind a tunnel) ──
# The same token on both sides; with it the OCR server reads only files sent to it from elsewhere, not paths.
# OCR_SERVER_TOKEN=
# OCR_SEND_FILES=1                     # the app sends the file itself (npm run deploy sets it)
# OCR_SERVER_URL=https://ocr.example.com

# ── Deploy (npm run deploy): put these in .env.cloudrun, not here (it is not committed) ──
# FIREBASE_PROJECT_ID, FIREBASE_API_KEY, ADMIN_EMAILS (as above)
# OCR_SERVER_URL=https://ocr.example.com      OCR_SERVER_TOKEN=<the one of this machine's OCR server>
# MINIO_ENDPOINT=minio.example.com           MINIO_PORT=443  MINIO_USE_SSL=true  MINIO_ACCESS_KEY=  MINIO_SECRET_KEY=
# MONGODB_URI=mongodb+srv://...           (reachable from Cloud Run: MongoDB Atlas, or this machine's port opened safely)
# MINIO_BUCKET, ACARS_BUCKET, SITE_BUCKET, SMTP_*, MAIL_FROM when not the defaults

# ── Cache (services/cache.js): Redis, shared by the app's instances; the /dashboard summary (1 min), airport weather (30 min) ──
# Without it (or while it is down) the cache stays in each process's memory. Keys go under REDIS_PREFIX: the database
# may hold other apps' keys, the app never empties it.
REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=rosterparser:
# REDIS_URL_DOCKER=                    # the URL inside the app container (default redis://host.docker.internal:6379)

# ── Accounts of the API (services/accounts.js, plans.js; /signup, /account, /users) ──
# Plans, keys and calls are kept in MongoDB (the sign-in itself stays in Firebase Authentication):
MONGODB_URI=mongodb://localhost:27017/rosterparser
# MONGODB_DB=rosterparser               # when the URI has no database
# MONGODB_URI_DOCKER=                  # the URI inside the app container (default mongodb://host.docker.internal:27017/rosterparser)
# ACCOUNTS_STORE=memory                # in memory instead: trying the pages without MongoDB (gone at restart)
# Requests and files read a day per plan (default Free 1000/50, Pro 20000/2000); a "free" plan is needed:
# API_PLANS={"free":{"label":"Free","requests":1000,"reads":50},"pro":{"label":"Pro","requests":20000,"reads":2000}}
# The proxies whose X-Forwarded-For gives the visitor's IP (per-IP limits of visitors without an account):
# TRUST_PROXY=loopback, linklocal, uniquelocal   # default: cloudflared / Docker on this machine; 2 behind Firebase Hosting + Cloud Run

# ── Payments: PayPal subscriptions (services/paypal.js, billing.js; /pricing, /account, /billing) ──
# A REST app of developer.paypal.com (Sandbox first: test buyers and cards, no real money). Prices: plans.js / API_PLANS
# ("prices": {"currency": "USD", "month": 9, "year": 90}); the PayPal product and plans are made on the first subscription.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox                   # live for real payments (a live app's keys)
# PAYPAL_WEBHOOK_ID=                   # the app's webhook to https://<this site>/api/billing/webhook (events: Billing subscription *, Payment sale *)
# The seller on the invoices
# BILLING_SELLER_NAME=RosterParser
# BILLING_SELLER_ADDRESS="Street, City, Country"
# BILLING_SELLER_EMAIL=billing@example.com
# BILLING_SELLER_TAX_ID=
