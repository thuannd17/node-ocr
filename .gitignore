# ---- Secrets / local config ----
.env
.env.*
!.env.example
google_vision.json
*.pem
*.key

# ---- Dependencies / environments ----
node_modules/
.venv/
__pycache__/
*.pyc

# ---- Editors / OS / tools ----
.idea/
.vscode/
.claude/settings.local.json
.DS_Store
Thumbs.db
# Stray file created by a Windows "> nul" redirect in a POSIX shell
nul

# ---- Generated data (rebuilt by the scripts) ----
# Since 2026-10-19 the app writes these outside the project (ROSTER_WORK_DIR, utils/paths.js); kept as a guard
tmp/
cache/
exports/
*.log

# ---- Roster data (real crew rosters: personal data; the repo is public) ----
# Images/PDFs (fake-data/<ext>/<guid>.<ext>) and their labels (labels/<ext>/) stay local.
fake-data/
labels/
# Correction suggestions sent from /upload (suggestions/<id>/: the roster file + meta.json)
suggestions/
# Since 2026-10-19 the folders above are only the old local data (npm run media:import moved it to MinIO).
# MEDIA_BACKEND=fs (no MinIO) keeps its objects here
media-data/

# ---- Models ----
# Only configuration is kept here: models/parser-patterns.json, models/dict/, models/rec/train-template.yml.
# Since 2026-10-19 every trained model lives in MinIO (models/rec/<ver>/, models/ai/<id>/, checkpoints)
# and is mirrored into ROSTER_WORK_DIR; pretrained/kfold are there too. Guard against old copies:
models/pretrained/
models/kfold/
models/rec/*/
models/pdf-tagger*/
models/ai/
__pycache__/
