{
  "name": "node-ocr",
  "version": "1.0.0",
  "description": "Test OCR",
  "main": "src/index.js",
  "type": "module",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "form-data": "^4.0.6",
    "leaflet": "^1.9.4",
    "maplibre-gl": "6.4.1",
    "minio": "^8.0.7",
    "mongodb": "^6.21.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pdfjs-dist": "^4.10.38",
    "redis": "^6.3.0",
    "sharp": "^0.35.5",
    "suncalc": "^1.9.0",
    "swagger-ui-dist": "^5.17.14",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build app",
    "media:import": "node --env-file=.env src/scripts/media-import.mjs",
    "models:archive": "node --env-file=.env src/scripts/models-archive.mjs",
    "test": "node --test --test-concurrency=1 tests",
    "ocr:server": ".\\.venv\\Scripts\\python -u src/scripts/ocr_server.py",
    "ocr:check": ".\\.venv\\Scripts\\python src/scripts/ocr_healthcheck.py",
    "ocr:benchmark": "node --env-file=.env src/scripts/ocr-benchmark.mjs",
    "ocr:train": "node --env-file=.env src/scripts/ocr-train.mjs",
    "ocr:use-model": "node --env-file=.env src/scripts/ocr-use-model.mjs",
    "ocr:kfold": "node --env-file=.env src/scripts/ocr-kfold.mjs",
    "ocr:groundtruth": "node --env-file=.env src/scripts/ocr-groundtruth.mjs",
    "model:train": "node --env-file=.env src/scripts/model-train.mjs",
    "model:benchmark": "node --env-file=.env src/scripts/model-benchmark.mjs",
    "acars:benchmark": "node --env-file=.env src/scripts/acars-benchmark.mjs",
    "acars:guid-names": "node --env-file=.env src/scripts/acars-guid-names.mjs",
    "model:eval-assembler": "node src/scripts/model-eval-assembler.mjs",
    "label:parse": "node --env-file=.env src/scripts/label-parse.mjs",
    "label:check": "node --env-file=.env src/scripts/label-check.mjs",
    "label:audit": "node --env-file=.env src/scripts/label-audit.mjs",
    "label:draft-tables": "node --env-file=.env src/scripts/label-draft-tables.mjs",
    "label:review": "node --env-file=.env src/scripts/label-review.mjs",
    "deploy": "node src/scripts/deploy.mjs",
    "auth:grant": "node --env-file=.env src/scripts/auth-grant.mjs",
    "airports:update": "node --env-file=.env src/scripts/airports-update.mjs"
  },
